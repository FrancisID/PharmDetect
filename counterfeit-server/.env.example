# Server
PORT=4000

# Write-protection: shared only with the Pharmaceutical Database server, which
# relays counterfeit/expired findings here. Leave blank for local testing.
API_KEY=

# SMTP credentials for the automatic report to the Ministry of Health agency
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
REPORT_FROM=pharmdetect@example.gov

# Who receives the automatic report
MOH_AGENCY_EMAIL=agency@moh.example.gov

# weekly or monthly
REPORT_FREQUENCY=monthly

# Secret used to sign login sessions (JWTs). Use a long random string in
# production — e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string

# The developer's superuser account. Created automatically on first boot if
# no superuser exists yet.
SUPERUSER_EMAIL=you@example.com
SUPERUSER_PASSWORD=change-this-strong-password
