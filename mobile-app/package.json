{
  "name": "pharmdetect-mobile-app",
  "version": "1.0.0",
  "description": "PharmDetect mobile app — Capacitor wrapper with native ML Kit QR scanning.",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --outfile=www/app.bundle.js --format=iife --platform=browser",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2" 
  }
}
