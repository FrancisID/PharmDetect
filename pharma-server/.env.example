# Server
PORT=3000

# Optional write-protection for POST /api/medications, /api/scan, /api/purchase.
# Leave blank while developing locally to disable the check.
API_KEY=

# Where the separately hosted Counterfeit and Fake Medication Database lives.
# This is the ONLY connection between the two services.
COUNTERFEIT_API_URL=http://localhost:4000
COUNTERFEIT_API_KEY=

# Secret used to sign login sessions (JWTs). Use a long random string in
# production — e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string

# The developer's superuser account. Created automatically on first boot if
# no superuser exists yet. Change the password after first login, or just
# set a strong one here before the very first start.
SUPERUSER_EMAIL=you@example.com
SUPERUSER_PASSWORD=change-this-strong-password
